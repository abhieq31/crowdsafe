# CrowdSafe camera device: reads a camera, sends per-zone density and motion numbers.
# Frames never leave the device. The density model is baked in (checksum verified), so it works offline.
#   docker run --rm -v $PWD/cam1.json:/cam.json ghcr.io/abhieq31/crowdsafe-edge \
#     edge --source rtsp://user:pass@cam1/stream --calibration /cam.json --server http://control-room:8000
FROM python:3.12-slim
WORKDIR /app
COPY pyproject.toml README.md LICENSE ./
COPY src ./src
ENV CROWDSAFE_HOME=/opt/crowdsafe PYTHONUNBUFFERED=1
RUN pip install --no-cache-dir ".[vision,onnx]" \
 && crowdsafe model fetch dense \
 && useradd --uid 10001 --create-home crowdsafe \
 && chmod -R a+rX /opt/crowdsafe
USER crowdsafe
ENTRYPOINT ["crowdsafe"]
CMD ["check"]
